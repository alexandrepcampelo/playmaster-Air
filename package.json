{
  "name": "playmaster-air-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "PlayMaster Air para Windows 11",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:win:portable": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "38.2.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "br.com.playmastersolutions.air",
    "productName": "PlayMaster Air",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "*.js",
      "*.png",
      "*.webmanifest",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PlayMaster-Air-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PlayMaster Air"
    }
  }
}
